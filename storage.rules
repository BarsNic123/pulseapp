rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function patientDoc(patientId) {
      return firestore.get(/databases/(default)/documents/users/$(patientId)).data;
    }

    function responderAssignedToPatient(patientId) {
      return firestore.exists(/databases/(default)/documents/users/$(patientId))
        && patientDoc(patientId).get("assignedResponderUid", "") == request.auth.uid;
    }

    match /voice_notes/{patientId}/{allPaths=**} {
      allow read: if request.auth != null && (
        request.auth.uid == patientId ||
        responderAssignedToPatient(patientId)
      );
      allow write: if request.auth != null && request.auth.uid == patientId;
    }
  }
}
