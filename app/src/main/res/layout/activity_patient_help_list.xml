<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/patientHelpListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pulse_surface"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarHelpList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/pulse_surface_card"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/help_list_title"
        app:titleTextColor="@color/pulse_on_surface" />

    <ProgressBar
        android:id="@+id/progressHelpList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:padding="16dp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHelpRequests"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="16dp" />
</LinearLayout>
