<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pulse_surface"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackProfile"
        style="@style/Pulse.IconButton.Back"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:contentDescription="@string/cd_back"
        app:icon="@drawable/ic_nav_back_surface"
        app:iconTint="@color/pulse_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/profile_title"
        android:textColor="@color/pulse_on_surface"
        android:textSize="26sp"
        android:textStyle="bold" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/pulse_surface_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/pulse_outline"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/FieldLabel"
                android:layout_marginBottom="4dp"
                android:text="@string/profile_label_name" />

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/pulse_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginBottom="4dp"
                android:text="@string/profile_label_age" />

            <TextView
                android:id="@+id/tvProfileAge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/pulse_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginBottom="4dp"
                android:text="@string/profile_label_blood" />

            <TextView
                android:id="@+id/tvProfileBlood"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/pulse_on_surface"
                android:textSize="16sp" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginBottom="4dp"
                android:text="@string/profile_label_emergency" />

            <TextView
                android:id="@+id/tvProfileAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/pulse_on_surface"
                android:textSize="16sp" />

            <TextView
                style="@style/FieldLabel"
                android:layout_marginBottom="4dp"
                android:text="@string/profile_assigned_label" />

            <TextView
                android:id="@+id/tvProfileAssigned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pulse_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEditProfile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:paddingVertical="14dp"
        android:text="@string/profile_edit"
        android:textAllCaps="false"
        app:cornerRadius="12dp"
        app:strokeColor="@color/pulse_primary"
        app:strokeWidth="1dp"
        style="@style/Widget.Material3.Button.OutlinedButton" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:paddingVertical="14dp"
        android:text="@string/profile_logout"
        android:textAllCaps="false"
        android:textColor="@color/white"
        app:backgroundTint="@color/pulse_error"
        app:cornerRadius="12dp" />

</LinearLayout>
