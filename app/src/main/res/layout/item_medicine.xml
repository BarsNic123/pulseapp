<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/pulse_surface_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/pulse_outline"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMedCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                android:textColor="@color/pulse_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Morning" />

            <TextView
                android:id="@+id/tvMedName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/pulse_on_surface"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Metformin" />

            <TextView
                android:id="@+id/tvMedDosage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/pulse_on_surface_variant"
                android:textSize="14sp"
                tools:text="500 mg" />

            <TextView
                android:id="@+id/tvMedInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/pulse_on_surface_variant"
                android:textSize="13sp"
                tools:text="With lunch" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMedTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/pulse_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="12:00 PM" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
